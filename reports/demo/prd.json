{
  "title": "审批管理系统",
  "summary": "构建在线审批管理系统，支持审批申请提交、多级审批流转、进度查询、历史记录导出及审批流配置，提升审批效率。",
  "background": "现有业务审批流程依赖线下沟通，效率低。",
  "target_users": [
    "审批管理员",
    "普通业务人员"
  ],
  "functional_requirements": [
    {
      "id": "FR-1",
      "title": "在线提交审批申请",
      "description": "普通业务人员可在线填写并提交审批申请，包含申请单编号、申请人、金额、审批状态、提交日期等字段。",
      "priority": "P0"
    },
    {
      "id": "FR-2",
      "title": "多级审批流转",
      "description": "系统支持多级审批流程，根据配置自动流转至相应审批人。",
      "priority": "P0"
    },
    {
      "id": "FR-3",
      "title": "审批进度查询",
      "description": "用户可查询自己提交的审批单的当前进度和状态。",
      "priority": "P0"
    },
    {
      "id": "FR-4",
      "title": "历史记录导出",
      "description": "管理员可导出审批历史记录，便于存档和分析。",
      "priority": "P1"
    },
    {
      "id": "FR-5",
      "title": "审批流配置",
      "description": "管理员可配置审批流程，包括审批节点、审批人、条件等，以适应业务变化。",
      "priority": "P0"
    },
    {
      "id": "FR-6",
      "title": "幂等提交",
      "description": "系统支持幂等提交，防止重复申请，重复点击提交不会产生重复单据。",
      "priority": "P0"
    },
    {
      "id": "FR-7",
      "title": "提交失败自动重试",
      "description": "提交失败时系统自动重试，确保申请提交成功。",
      "priority": "P1"
    },
    {
      "id": "FR-8",
      "title": "列表分页加载",
      "description": "列表查询需要分页，超过100条分批加载，提高性能。",
      "priority": "P1"
    }
  ],
  "non_functional": [
    "系统必须支持幂等提交，防止重复申请。",
    "提交失败时自动重试。",
    "列表查询需要分页，超过100条分批加载。"
  ],
  "permissions": [
    "管理员可配置审批流并查看全部数据。",
    "普通用户只能查看自己提交的记录。"
  ],
  "data_model": [
    {
      "name": "审批申请单",
      "fields": [
        {
          "name": "申请单编号",
          "type": "string",
          "required": true,
          "note": null
        },
        {
          "name": "申请人",
          "type": "string",
          "required": true,
          "note": null
        },
        {
          "name": "金额",
          "type": "number",
          "required": true,
          "note": null
        },
        {
          "name": "审批状态",
          "type": "enum",
          "required": true,
          "note": null
        },
        {
          "name": "提交日期",
          "type": "date",
          "required": true,
          "note": null
        }
      ]
    }
  ],
  "pages": [
    {
      "id": "page-1",
      "title": "提交审批申请",
      "description": "普通业务人员填写并提交审批申请。",
      "components": [
        "form"
      ],
      "states": [
        "default",
        "error",
        "success"
      ],
      "interactions": [
        "提交申请",
        "校验必填字段",
        "幂等处理"
      ],
      "form_fields": [
        {
          "name": "applicationNo",
          "label": "申请单编号",
          "type": "text",
          "required": true,
          "options": []
        },
        {
          "name": "applicant",
          "label": "申请人",
          "type": "text",
          "required": true,
          "options": []
        },
        {
          "name": "amount",
          "label": "金额",
          "type": "number",
          "required": true,
          "options": []
        },
        {
          "name": "status",
          "label": "审批状态",
          "type": "select",
          "required": true,
          "options": [
            "待审批",
            "审批中",
            "已通过",
            "已拒绝"
          ]
        },
        {
          "name": "submitDate",
          "label": "提交日期",
          "type": "date",
          "required": true,
          "options": []
        }
      ]
    },
    {
      "id": "page-2",
      "title": "审批进度查询",
      "description": "用户查询自己提交的审批单进度。",
      "components": [
        "table"
      ],
      "states": [
        "default",
        "empty",
        "error"
      ],
      "interactions": [
        "查询",
        "分页加载"
      ],
      "form_fields": []
    },
    {
      "id": "page-3",
      "title": "审批流配置",
      "description": "管理员配置审批流程。",
      "components": [
        "form",
        "table"
      ],
      "states": [
        "default",
        "empty",
        "error"
      ],
      "interactions": [
        "添加节点",
        "编辑节点",
        "删除节点",
        "保存配置"
      ],
      "form_fields": [
        {
          "name": "nodeName",
          "label": "节点名称",
          "type": "text",
          "required": true,
          "options": []
        },
        {
          "name": "approver",
          "label": "审批人",
          "type": "text",
          "required": true,
          "options": []
        },
        {
          "name": "condition",
          "label": "条件",
          "type": "text",
          "required": false,
          "options": []
        }
      ]
    },
    {
      "id": "page-4",
      "title": "历史记录导出",
      "description": "管理员导出审批历史记录。",
      "components": [
        "button"
      ],
      "states": [
        "default",
        "error"
      ],
      "interactions": [
        "导出"
      ],
      "form_fields": []
    }
  ],
  "acceptance_criteria": [
    "管理员可完成审批流配置并生效。",
    "用户提交后可查询到进度。",
    "重复点击提交不会产生重复单据。"
  ],
  "open_questions": [
    "审批流配置的具体规则和条件表达式如何定义？",
    "是否需要支持审批人委派或转交？",
    "历史记录导出的格式要求是什么？"
  ]
}